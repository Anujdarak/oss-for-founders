# Copy this file to .env and fill it in. .env is gitignored; this template is not.
#
#   cp .env.example .env          # macOS / Linux
#   Copy-Item .env.example .env   # PowerShell
#
# Nothing here is needed to run the site locally. `npm run dev` works with an
# empty file: the catalogue is committed JSON and the site makes no network
# calls at runtime.


# ---------------------------------------------------------------------------
# GITHUB_TOKEN  -- needed only by the build scripts, never by the site
# ---------------------------------------------------------------------------
#
# Used by:
#   npm run discover        the bulk import (impossible without this)
#   npm run refresh-stats   refreshing stars/forks/licence for curated repos
#   npm run add-repo        optional; works unauthenticated for one-off adds
#
# Without it the API allows 60 requests/hour, which is not enough to import
# thousands of repos. With it, 5,000/hour.
#
# Create one at https://github.com/settings/tokens/new with NO SCOPES ticked.
# Everything this project reads is public, so a scopeless token is all it needs
# and is the least dangerous thing to leave on a laptop.
#
# The weekly GitHub Action does not use this value -- it uses the token the
# Action is given automatically.
#
GITHUB_TOKEN=


# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL  -- the site's own public address
# ---------------------------------------------------------------------------
#
# Used for canonical links, Open Graph tags, sitemap.xml and robots.txt.
# Leave it unset locally; it falls back to http://localhost:3000.
#
# Set it in your host's environment settings when you deploy, not here:
#   NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
#
# NEXT_PUBLIC_ means it is compiled into the browser bundle, so it must never
# hold anything secret. It holds a URL, which is already public.
#
NEXT_PUBLIC_SITE_URL=


# ---------------------------------------------------------------------------
# NEXT_PUBLIC_ASSISTANT_ENGINE  -- which /ask engine to use
# ---------------------------------------------------------------------------
#
# Only "keyword" is implemented, and it is the default. The variable exists so
# an LLM-backed engine can be swapped in later without touching the UI; an
# unrecognised value falls back to keyword rather than failing.
#
# NEXT_PUBLIC_ASSISTANT_ENGINE=keyword


# ---------------------------------------------------------------------------
# LLM_PROVIDER / LLM_API_KEY  -- optional, makes /ask smarter
# ---------------------------------------------------------------------------
#
# The assistant works with NO key. Without one it understands your question
# with a local need taxonomy and ranks with embeddings + BM25, entirely
# offline. A key adds two things on top: free-form understanding of questions
# the taxonomy has no pattern for, and a written one-line reason per result.
#
# Note there is deliberately no NEXT_PUBLIC_ prefix on either of these. They
# are read only inside app/api/ask/route.ts, which runs on the server, so the
# key is never compiled into the browser bundle. Adding the prefix would
# publish your key to every visitor.
#
# LLM_PROVIDER is one of: gemini | groq | openrouter   (default: gemini)
#
#   gemini      https://aistudio.google.com/apikey      free tier
#   groq        https://console.groq.com/keys           free tier
#   openrouter  https://openrouter.ai/keys              has free models
#
LLM_PROVIDER=
LLM_API_KEY=

# Optional. Overrides the per-provider default model:
#   gemini      gemini-flash-lite-latest
#   groq        llama-3.3-70b-versatile      (unverified -- no key to test with)
#   openrouter  google/gemini-2.0-flash-001  (unverified -- no key to test with)
#
# The gemini default is lite on purpose. On a free-tier key the bigger flash
# models returned 503 "high demand" about half the time, while lite answered
# every call in 1-3s. If a model name ever 404s ("no longer available"), set
# this to a current one -- the server log prints exactly what came back.
#
# LLM_MODEL=


# ---------------------------------------------------------------------------
# Several providers at once (round robin)
# ---------------------------------------------------------------------------
# Set two or more of these and requests rotate between them, falling over to
# the next when one is rate-limited or down. That is the point: free tiers are
# small, and one provider taking every request hits its daily cap by lunchtime.
#
#   GEMINI_API_KEY      https://aistudio.google.com/apikey
#   GROK_API_KEY        https://console.x.ai           -- xAI, api.x.ai
#   GROQ_API_KEY        https://console.groq.com/keys  -- Groq Cloud, a DIFFERENT
#                       company from xAI's Grok. One letter apart; easy to mix up.
#   OPENROUTER_API_KEY  https://openrouter.ai/keys
#
# GEMINI_API_KEY=
# GROK_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Per-provider model overrides. Defaults are in lib/assistant/llm.ts, which
# records which were probed against a real key and which are still unverified.
# GROK_MODEL is worth setting: grok-3 is a guess, and a guessed model name is
# exactly what aged into a 404 for Gemini. Check GET https://api.x.ai/v1/models.
#
# GEMINI_MODEL=
# GROK_MODEL=
# GROQ_MODEL=
# OPENROUTER_MODEL=


# ---------------------------------------------------------------------------
# NEXT_PUBLIC_CF_BEACON_TOKEN -- visitor counts (optional)
# ---------------------------------------------------------------------------
# Cloudflare Web Analytics. Free, no cookie, so no consent banner, and it
# counts unique visitors rather than raw requests.
#
#   1. https://dash.cloudflare.com -> Analytics & Logs -> Web Analytics
#   2. "Add a site", enter oss-for-founders.antideploy.app
#   3. It shows a snippet containing token: "abc123..." -- copy just the token
#
# NEXT_PUBLIC_ is correct and is not a leak: the beacon token is a public site
# identifier, visible in the page source of every site that uses this, and it
# grants no access to anything.
#
# Leave it unset and no analytics script loads at all.
#
# NEXT_PUBLIC_CF_BEACON_TOKEN=
